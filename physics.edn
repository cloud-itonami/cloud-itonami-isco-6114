;; What this vertical's robot physically does, declared for
;; kotoba.robotics.process (kotoba-lang/robotics). `kbb -M:physics` runs it.
;;
;; README "Robotics premise": a field robot performs sowing, weeding and
;; targeted harvest support across mixed crop plots (ISCO 6114). Its physical
;; work here: driving loaded between scattered plots and the collection point,
;; and lifting a filled harvest crate onto its own carrier deck.
;;
;; Every number without a cited source is marked `estimate` in its :basis.
;; Replacing an estimate with a sourced value is this bot's growth work.
{:physics/schema "itonami.physical-ai.spec.v1"
 :repo "cloud-itonami/cloud-itonami-isco-6114"
 :cases
 [{:id :plot-to-collection-point
   :kind :transport
   :procedure "field robot carries harvested produce from a crop plot to the farm collection point over a grass-and-dirt track"
   :params {:mass-kg 100.0 :payload-kg 60.0 :v-max-mps 1.2 :a-max-mps2 0.3
            :brake-decel-mps2 0.6 :drive-force-n 300.0 :crr 0.07
            :cog-height-m 0.55 :support-half-length-m 0.40}
   :sweep {:param :distance-m :values [50.0 100.0 200.0 300.0 400.0]}
   :quantity :cycle-time-s
   :limit {:max 300.0 :basis "estimate: a 5-minute round-trip half keeps the harvest crew from waiting for an empty crate"}
   :boundary {:lo 10.0 :hi 800.0}}
  {:id :crate-onto-carrier-deck
   :kind :manipulator
   :procedure "arm lifts a filled harvest crate from the furrow onto the carrier deck"
   :params {:l1-m 0.55 :l2-m 0.45 :m1-kg 7.0 :m2-kg 5.0
            :from [0.65 -0.10] :to [0.25 0.60] :duration-s 2.5 :steps 500}
   :sweep {:param :payload-kg :values [2.0 5.0 10.0 15.0 20.0]}
   :quantity :peak-tau1-nm
   :limit {:max 120.0 :basis "estimate: continuous shoulder torque of a ~12 kg payload class arm on a field carrier"}
   :boundary {:lo 0.5 :hi 40.0}}]}
